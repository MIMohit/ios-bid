# ---------------------------------------------------------------------------
# Local development. The Convex CLI fills the Convex block in for you:
#
#   npx convex dev --once --configure existing --team mimohit77 \
#     --project iosbid --dev-deployment cloud
#
# It writes CONVEX_DEPLOYMENT, VITE_CONVEX_URL and VITE_CONVEX_SITE_URL into
# .env.local, which is gitignored. Convex 1.45 detects Vite and writes the
# VITE_-prefixed names itself, so nothing needs copying by hand. Vite only
# exposes VITE_-prefixed variables to the client, and the router throws
# "missing VITE_CONVEX_URL" without that one.
#
# On Vercel the build writes VITE_CONVEX_URL instead, via
# `convex deploy --cmd-url-env-var-name VITE_CONVEX_URL`. Never set it by hand
# there: that is how a preview ends up writing to production data.
# ---------------------------------------------------------------------------

CONVEX_DEPLOYMENT="dev:replace-me"
VITE_CONVEX_URL="https://replace-me.convex.cloud"
VITE_CONVEX_SITE_URL="https://replace-me.convex.site"

# Public datafa.st site id. Omit on preview so preview traffic is not counted.
VITE_DATAFAST_ID=""

# Shared secret the Vercel server sends to the two guarded Convex httpAction
# write endpoints. Same value here and in `npx convex env set EDGE_SECRET`.
EDGE_SECRET="replace-me"

# ---------------------------------------------------------------------------
# Convex deployment variables. These live ON the deployment, not in this file.
# Set them with `npx convex env set NAME value`, never by editing .env.local.
#
#   STRIPE_SECRET_KEY       sk_test_... while we build, sk_live_... at launch
#   STRIPE_WEBHOOK_SECRET   whsec_..., from `pnpm stripe:listen` or the Dashboard
#   SITE_ORIGIN             https://iosbid.lol, for Stripe success/cancel URLs
#   EDGE_SECRET             the same value as above
#
# The Stripe Dashboard webhook endpoint is $VITE_CONVEX_SITE_URL/stripe.
# Pointing it at .convex.cloud returns 404 forever.
# ---------------------------------------------------------------------------
