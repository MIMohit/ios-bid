{
  "include": ["src", "convex", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2024",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "paths": {
      "~/*": ["./src/*"],
      "@convex/*": ["./convex/*"]
    }
  }
}
